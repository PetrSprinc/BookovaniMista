@{
    ViewData["Title"] = "Zabookovat místo";
}
<h1>@ViewData["Title"]</h1>

<p class="lead">Možnost zabookvat jedno místo pro zvolený den. Klikněte na sekci mapy pro detail.</p>

<div class="card mb-4">
    <div class="card-body">
        <p>Klikněte na sekci mapy pro zobrazení detailu.</p>

        <div class="mb-3" style="max-width:260px;">
            <label for="booking-date" class="form-label">Vyberte den rezervace</label>
            <input id="booking-date" name="bookingDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <div class="form-text">Vybraný den bude odeslán spolu se žádostí o zabookování.</div>
        </div>

        <div class="ratio ratio-16x9">
            <svg viewBox="0 0 1000 500" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;">
                <!-- Horní řada: 4 sekce-->
                <a href="#SJ1"><rect x="20"  y="20"  width="220" height="200" class="section" data-id="1" /></a>
                <a href="#SJ2"><rect x="260" y="20"  width="220" height="200" class="section" data-id="2" /></a>
                <a href="#SJ3"><rect x="500" y="20"  width="220" height="200" class="section" data-id="3" /></a>
                <a href="#SJ4"><rect x="740" y="20"  width="220" height="200" class="section" data-id="4" /></a>

                <!-- Dolní řada: 5 sekcí -->
                <a href="#SS1"><rect x="20"  y="260" width="150" height="200" class="section" data-id="5" /></a>
                <a href="#SS2"><rect x="190" y="260" width="150" height="200" class="section" data-id="6" /></a>
                <a href="#SS3"><rect x="360" y="260" width="150" height="200" class="section" data-id="7" /></a>
                <a href="#SS4"><rect x="530" y="260" width="150" height="200" class="section" data-id="8" /></a>
                <a href="#SS5"><rect x="700" y="260" width="150" height="200" class="section" data-id="9" /></a>

                <!-- Štítky-->
                <a href="#SJ1"><text x="130" y="120" text-anchor="middle" class="label">Sekce jih 1</text></a>
                <a href="#SJ2"><text x="370" y="120" text-anchor="middle" class="label">Sekce jih 2</text></a>
                <a href="#SJ3"><text x="610" y="120" text-anchor="middle" class="label">Sekce jih 3</text></a>
                <a href="#SJ4"><text x="850" y="120" text-anchor="middle" class="label">Sekce jih 4</text></a>

                <a href="#SS1"><text x="95" y="360" text-anchor="middle" class="label">Sekce sever 1</text></a>
                <a href="#SS2"><text x="265" y="360" text-anchor="middle" class="label">Sekce sever 2</text></a>
                <a href="#SS3"><text x="435" y="360" text-anchor="middle" class="label">Sekce sever 3</text></a>
                <a href="#SS4"><text x="605" y="360" text-anchor="middle" class="label">Sekce sever 4</text></a>
                <a href="#SS5"><text x="775" y="360" text-anchor="middle" class="label">Sekce sever 5</text></a>
            </svg>
        </div>
    </div>
</div>

<!-- Detailní panely pro každou sekci-->
<div id="SJ1" class="overlay" aria-hidden="true" data-sekce-db="1">
    <div class="detail">
        <a class="close" href="#" aria-label="Zavřít">&times;</a>
        <h3>Sekce jih 1</h3>
        <p class="muted">Severní levá sekce — vizualizace míst</p>
        <div class="seats-grid">
            @{
                var total = 15;
                var rows = 3;
                var cols = (int)Math.Ceiling(total / (double)rows);
            }
            <div style="display:grid; grid-template-columns:repeat(@cols, 1fr); gap:.5rem;">
                @for (int r = 0; r < rows; r++)
                {
                    for (int c = 0; c < cols; c++)
                    {
                        var idx = r * cols + c + 1;
                        if (idx <= total)
                        {
                            <button type="button" class="btn btn-outline-primary seat" data-seat="@idx">@idx</button>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

