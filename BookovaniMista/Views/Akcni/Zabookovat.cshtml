@using Business.BookovaniMista
@using Business.BookovaniMista.Interfaces
@inject IMapaBusiness Mapa
@{
    ViewData["Title"] = "Zabookovat místo";
    // preferuj hodnotu předanou z controlleru, fallback na claim / identity
    string? currentUsername = ViewData["CurrentUsername"] as string
                              ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                              ?? User.Identity?.Name;
}

<h1>@ViewData["Title"]</h1>

@{
    var bookingDateString = Context.Request.Query["bookingDate"].FirstOrDefault();
    if (string.IsNullOrEmpty(bookingDateString) && Context.Request.HasFormContentType)
        bookingDateString = Context.Request.Form["bookingDate"].FirstOrDefault();
    bookingDateString ??= DateTime.Today.ToString("yyyy-MM-dd");
    DateTime bookingDate = DateTime.TryParse(bookingDateString, out var parsedDate) ? parsedDate.Date : DateTime.Today;
}

@await Mapa.RenderBookingForm(bookingDate)

<!-- Detail panels for each section -->
@{
    var sections = new[]
    {
        new { Id = "SJ1", Db = 1, Title = "Sekce jih 1", Subtitle = "Severní levá sekce — vizualizace míst", Total = 15, Rows = 3 },
        new { Id = "SJ2", Db = 2, Title = "Sekce jih 2", Subtitle = "Severní střed-levo — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SJ3", Db = 3, Title = "Sekce jih 3", Subtitle = "Severní střed-pravo — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SJ4", Db = 4, Title = "Sekce jih 4", Subtitle = "Severní pravá sekce — vizualizace míst", Total = 6, Rows = 3 },
        new { Id = "SS1", Db = 5, Title = "Sekce sever 1", Subtitle = "Jižní 1/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS2", Db = 6, Title = "Sekce sever 2", Subtitle = "Jižní 2/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS3", Db = 7, Title = "Sekce sever 3", Subtitle = "Jižní 3/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS4", Db = 8, Title = "Sekce sever 4", Subtitle = "Jižní 4/5 — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SS5", Db = 9, Title = "Sekce sever 5", Subtitle = "Jižní 5/5 — vizualizace míst", Total = 6, Rows = 3 }
    };

    var sekceDbIds = sections.Select(s => s.Db).ToArray();
    var allReservations = await Mapa.GetAllReservationsForDateAsync(bookingDate, sekceDbIds);
}

@foreach (var s in sections)
{
    @Mapa.RenderSectionOverlay(s.Db, s.Id, s.Title, s.Subtitle, s.Total, s.Rows, bookingDate, currentUsername, allReservations[s.Db])
}

@* Confirm dialog (HTML-only, CSS + JS below) *@
<div id="confirm-dialog" class="confirm-overlay" aria-hidden="true">
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <h4 id="confirm-title">Potvrzení</h4>
        <p id="confirm-message">Opravdu chcete zabookovat vybrané místo?</p>
        <div class="confirm-actions">
            <button type="button" id="confirm-yes" class="btn btn-primary">Ano</button>
            <button type="button" id="confirm-cancel" class="btn btn-secondary">Zrušit</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js"></script>
}