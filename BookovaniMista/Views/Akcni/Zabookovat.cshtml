@using Business.BookovaniMista
@using Business.BookovaniMista.Interfaces
@using Business.BookovaniMista.Resources
@inject IMapaBusiness Mapa
@inject ICommonBusiness CommonBusinessService
@{
    ViewData[Constants.ViewDataKeys.Title] = "Zabookovat místo";

    // Get current username
    string? currentUsername = ViewData[Constants.ViewDataKeys.CurrentUsername] as string
                              ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                              ?? User.Identity?.Name;

    var bookingDateString = Context.Request.Query[Constants.RequestParameters.BookingDate].FirstOrDefault();
    if (string.IsNullOrEmpty(bookingDateString) && Context.Request.HasFormContentType)
    {
        bookingDateString = Context.Request.Form[Constants.RequestParameters.BookingDate].FirstOrDefault();
    }
    DateTime bookingDate = CommonBusiness.ParseBookingDate(bookingDateString);

    var sections = CommonBusinessService.GetSectionDefinitions();
    var sekceDbIds = sections.Select(s => s.Db).ToArray();
    var allReservations = await Mapa.GetAllReservationsForDateAsync(bookingDate, sekceDbIds);
}

<!-- ✅ Booking Container with API Endpoint -->
<div id="@Constants.HtmlIds.BookingContainer" data-api-endpoint="@Constants.ApiEndpoints.Rezervovat">
    <!-- ✅ Booking Form PartialView -->
    @await Html.PartialAsync(Constants.PartialViewNames.BookingForm, new { Date = bookingDate, Sections = sections })

    <!-- ✅ Section Overlays PartialViews -->
    @foreach (var s in sections)
    {
        @await Html.PartialAsync(Constants.PartialViewNames.SeatGrid, new
        {
            SekceDbId = s.Db,
            AnchorId = s.Id,
            Title = s.Title,
            Subtitle = s.Subtitle,
            Total = s.Total,
            Rows = s.Rows,
            BookedIndices = allReservations[s.Db],
            CurrentUsername = currentUsername,
            ShowOwnerName = false
        })
    }

    <!-- ✅ Confirmation Dialog PartialView -->
    @await Html.PartialAsync(Constants.PartialViewNames.ConfirmDialog)

    <!-- ✅ CSRF Token Protection -->
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script src="~/js/booking.js"></script>
}
