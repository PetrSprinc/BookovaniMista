@using Business.BookovaniMista
@using Business.BookovaniMista.Interfaces
@inject IMapaBusiness Mapa
@{
    ViewData["Title"] = "Zabookovat místo";
    // preferuj hodnotu předanou z controlleru, fallback na claim / identity
    string? currentUsername = ViewData["CurrentUsername"] as string
                              ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                              ?? User.Identity?.Name;
}
<h1>@ViewData["Title"]</h1>

@* Přesunuto do business vrstvy, vykreslí mapu se zvoleným datem (výchozí dnes) *@
@await Mapa.RenderMapCardAsync(DateTime.Today)

<!-- Detailní panely pro každou sekci-->
@{
    var sections = new[]
    {
        new { Id = "SJ1", Db = 1, Title = "Sekce jih 1", Subtitle = "Severní levá sekce — vizualizace míst", Total = 15, Rows = 3 },
        new { Id = "SJ2", Db = 2, Title = "Sekce jih 2", Subtitle = "Severní střed-levo — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SJ3", Db = 3, Title = "Sekce jih 3", Subtitle = "Severní střed-pravo — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SJ4", Db = 4, Title = "Sekce jih 4", Subtitle = "Severní pravá sekce — vizualizace míst", Total = 6, Rows = 3 },
        new { Id = "SS1", Db = 5, Title = "Sekce sever 1", Subtitle = "Jižní 1/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS2", Db = 6, Title = "Sekce sever 2", Subtitle = "Jižní 2/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS3", Db = 7, Title = "Sekce sever 3", Subtitle = "Jižní 3/5 — vizualizace míst", Total = 12, Rows = 3 },
        new { Id = "SS4", Db = 8, Title = "Sekce sever 4", Subtitle = "Jižní 4/5 — vizualizace míst", Total = 18, Rows = 3 },
        new { Id = "SS5", Db = 9, Title = "Sekce sever 5", Subtitle = "Jižní 5/5 — vizualizace míst", Total = 6, Rows = 3 }
    };
}

@foreach (var s in sections)
{
    @await Mapa.RenderSectionOverlayAsync(s.Db, s.Id, s.Title, s.Subtitle, s.Total, s.Rows, DateTime.Today, currentUsername)
}

@* Confirm dialog (HTML-only, CSS + JS below) *@
<div id="confirm-dialog" class="confirm-overlay" aria-hidden="true">
    <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <h4 id="confirm-title">Potvrzení</h4>
        <p id="confirm-message">Opravdu chcete zabookovat vybrané místo?</p>
        <div class="confirm-actions">
            <button id="confirm-yes" class="btn btn-primary">Ano</button>
            <button id="confirm-cancel" class="btn btn-secondary">Zrušit</button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* SVG sekce */
        .section { fill:#0d6efd22; stroke:#0d6efd; stroke-width:2; cursor:pointer; transition:fill .12s, transform .08s; }
        a .section:hover { fill:#0d6efd55; transform: scale(1.01); }
        .label { fill:#0d6efd; font-weight:700; font-size:24px; pointer-events:none; }

        /* Overlay detailu (CSS-only: :target) */
        .overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); align-items:center; justify-content:center; z-index:1050; padding:1rem; }
        .overlay:target { display:flex; }
        .detail { background:#fff; padding:1.25rem; border-radius:.5rem; max-width:760px; width:100%; box-shadow:0 8px 24px rgba(0,0,0,.2); position:relative; }
        .detail .close { position:absolute; right:.5rem; top:.25rem; font-size:2rem; color:#666; text-decoration:none; line-height:1; }
        .detail .muted { color:#6c757d; margin-top:-.25rem; margin-bottom:.75rem; }

        /* Grid míst - container display je definován inline, zde základní styly */
        .seats-grid { margin-top:.75rem; }
        .seat { min-height:48px; display:flex; align-items:center; justify-content:center; font-weight:600; border-radius:.375rem; padding:.5rem 0; }

        /* Stav míst: available / booked by other / booked by me */
        .seat.available { background: #198754; color: #fff; border: none; } /* zelená */
        .seat.booked-other { background: #dc3545; color: #fff; border: none; } /* červená */
        .seat.booked-me { background: #0d6efd; color: #fff; border: none; } /* modrá */

        /* Confirm dialog styles */
        .confirm-overlay { position:fixed; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.45); z-index:2000; }
        .confirm-overlay[aria-hidden="true"] { display:none; }
        .confirm-dialog { background:#fff; padding:1rem 1.25rem; border-radius:.5rem; width:320px; max-width:90%; box-shadow:0 12px 40px rgba(0,0,0,.25); }
        .confirm-actions { display:flex; gap:.5rem; justify-content:flex-end; margin-top:1rem; }
    </style>
}

<script>
    (function () {
        let currentButton = null;
        const dialog = document.getElementById('confirm-dialog');
        const messageEl = document.getElementById('confirm-message');
        const yesBtn = document.getElementById('confirm-yes');
        const cancelBtn = document.getElementById('confirm-cancel');
        const dateInput = document.getElementById('booking-date');

        if (!dialog || !messageEl) {
            console.error('Confirm dialog elements not found.');
            return;
        }

        // Delegovaná obsluha kliknutí na tlačítka míst
        document.addEventListener('click', function (ev) {
            const target = ev.target;
            const btn = (target && typeof target.closest === 'function') ? target.closest('.seat') : null;
            if (!btn) return;
            if (btn.classList.contains('booked-other') || btn.disabled) return;

            ev.preventDefault();
            currentButton = btn;
            const seatText = btn.getAttribute('data-seat') || btn.textContent.trim();

            // zjistit id sekce z rodičovského overlayu (data-sekce-db)
            const overlay = btn.closest('.overlay');
            const sekceDb = overlay ? overlay.getAttribute('data-sekce-db') : (btn.getAttribute('data-sekce-id') || '');

            const selectedDate = dateInput ? dateInput.value : '';

            messageEl.textContent = (sekceDb && selectedDate)
                ? `Opravdu chcete zabookovat místo ${seatText} (sekce ${sekceDb}) na datum ${selectedDate}?`
                : (sekceDb ? `Opravdu chcete zabookovat místo ${seatText} (sekce ${sekceDb})?` : `Opravdu chcete zabookovat místo ${seatText}?`);

            // Zobrazit dialog (aria + inline style pro jistotu)
            dialog.setAttribute('aria-hidden', 'false');
            dialog.style.display = 'flex';
        });

        if (cancelBtn) {
            cancelBtn.addEventListener('click', function () {
                dialog.setAttribute('aria-hidden', 'true');
                dialog.style.display = 'none';
                currentButton = null;
            });
        }

        if (yesBtn) {
            yesBtn.addEventListener('click', function () {
                if (!currentButton) {
                    dialog.setAttribute('aria-hidden', 'true');
                    dialog.style.display = 'none';
                    return;
                }

                const btn = currentButton;
                const seatNumber = btn.getAttribute('data-seat') || btn.textContent.trim();
                const overlay = btn.closest('.overlay');
                const sekceDb = overlay ? overlay.getAttribute('data-sekce-db') : (btn.getAttribute('data-sekce-id') || '');
                const selectedDate = dateInput ? dateInput.value : '';

                // Lokální vizuální akce: označit zabookované modře pro uživatele
                btn.classList.add('booked-me');
                btn.disabled = true;

                // Sestavit payload pro server
                const payload = {
                    sekceId: sekceDb || null,
                    seatNumber: seatNumber,
                    date: selectedDate || null
                };

                // TODO Zkusit získat anti-forgery token pokud je přítomen na stránce
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const headers = { 'Content-Type': 'application/json' };
                if (tokenInput) {
                    headers['RequestVerificationToken'] = tokenInput.value;
                }

                // Odeslat POST požadavek na server
                fetch('/Akcni/Rezervovat', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(payload)
                }).then(function (resp) {
                    if (!resp.ok) {
                        // rollback vizuální změny při chybě
                        btn.classList.remove('booked-me');
                        btn.disabled = false;
                        return resp.text().then(t => { throw new Error(t || resp.statusText); });
                    }
                    return resp.json().catch(() => null);
                }).then(function (data) {
                    console.log('Booking successful', data);
                    // můžete zobrazit notifikaci, nebo přesměrovat
                }).catch(function (err) {
                    console.error('Booking failed', err);
                    alert('Chyba při ukládání rezervace: ' + (err && err.message ? err.message : 'server error'));
                }).finally(function () {
                    dialog.setAttribute('aria-hidden', 'true');
                    dialog.style.display = 'none';
                    currentButton = null;
                });
            });
        }

        // Zavřít dialog při ESC
        document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && dialog.getAttribute('aria-hidden') === 'false') {
                dialog.setAttribute('aria-hidden', 'true');
                dialog.style.display = 'none';
                currentButton = null;
            }
        });
    })();
</script>
