@model Entities.BookovaniMista.ViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Vítej člověče!</h1>
    <div class="d-grid gap-2 col-6 mx-auto">
        <a asp-controller="Akcni" asp-action="Zabookovat" class="btn btn-primary">Zabookovat místo</a>
        <a asp-controller="Zobrazeni" asp-action="Historie" class="btn btn-primary">Moje historie</a>
        <a asp-controller="Zobrazeni" asp-action="Obsazenost" class="btn btn-primary">Obsazenost místnosti</a>
        <a asp-controller="Zobrazeni" asp-action="Vytizenost" class="btn btn-primary">Vytíženost míst</a>
    </div>
</div>

<div class="mt-5">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Misto.Oznaceni</th>
                <th>DatumRezervace</th>
                <th>Zamestnanec.Jmeno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rezervace in Model.Rezervace)
            {
                <tr>
                    <td>@rezervace.Id</td>
                    <td>@rezervace.Misto.Oznaceni</td>
                    <td>@rezervace.DatumRezervace</td>
                    <td>@rezervace.Zamestnanec.Jmeno</td>
                </tr>
            }
        </tbody>
    </table>
</div>

