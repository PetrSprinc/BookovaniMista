@model dynamic
<!-- Reuse _SectionMap PartialView -->
@await Html.PartialAsync("_SectionMap", new
{
    Date = Model?.Date,
    Sections = Model?.Sections,
    IntroText = "Kliknìte na sekci mapy pro zobrazení detailu.",
    MapTitle = "Vyberte den rezervace",
    MapDescription = "Vybraný den bude odeslán spolu se žádostí o zabookování.",
    ReadOnly = false,
    OnChangeScript = "document.querySelector('form').submit();"
})
