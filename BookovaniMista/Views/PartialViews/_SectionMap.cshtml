@model dynamic

@{
    var bookingDate = Model?.Date ?? (DateTime)ViewData["BookingDate"]!;
    var today = bookingDate.ToString("yyyy-MM-dd");
    const int maxDaysInFuture = 365;
    var maxDate = bookingDate.AddDays(maxDaysInFuture).ToString("yyyy-MM-dd");

    var mapTitle = Model?.MapTitle ?? "Vyberte den";
    var mapDescription = Model?.MapDescription ?? "";
    var isReadOnly = Model?.ReadOnly ?? false;
    var onChangeScript = Model?.OnChangeScript ?? "document.location = '?bookingDate=' + this.value";

    // Sekce z Model
    dynamic[] allSections = Model?.Sections ?? Array.Empty<dynamic>();

    // Dynamicky naèti øádky podle konfigurací
    var rows = new Dictionary<int, (int id, int seats)[]>();
    foreach (var (prefix, yPosition) in MapConfiguration.RowConfigurations)
    {
        var rowSections = allSections
            .Where(s => ((string)s.Id).StartsWith(prefix))
            .Select(s => (id: (int)s.Db, seats: (int)s.Total))
            .ToArray();

        if (rowSections.Length > 0)
        {
            rows[MapConfiguration.RowConfigurations.ToList().IndexOf((prefix, yPosition))] = rowSections;
        }
    }

    // Výpoèet pozic pro všechny øádky
    var allRowsData = new Dictionary<int, List<(int Id, int X, int Y, int Width, int Height)>>();
    for (int i = 0; i < MapConfiguration.RowConfigurations.Length; i++)
    {
        if (rows.ContainsKey(i))
        {
            var (prefix, yPosition) = MapConfiguration.RowConfigurations[i];
            var rowSectionsData = CalculateRowPositions(rows[i],
                MapConfiguration.SvgViewBoxWidth,
                MapConfiguration.SvgMarginX,
                yPosition,
                MapConfiguration.SvgRowHeight);
            allRowsData[i] = rowSectionsData;
        }
    }

    // Sluèit všechny øádky do jednoho seznamu
    var allRowData = allRowsData.Values.SelectMany(x => x).ToList();
}

<div class="card mb-4">
    <div class="card-body">
        <p>@(Model?.IntroText ?? "Kliknìte na sekci mapy pro zobrazení detailu.")</p>

        <div class="mb-3" style="max-width:260px;">
            <label for="booking-date" class="form-label">@mapTitle</label>
            <input id="booking-date" name="bookingDate" type="date" class="form-control"
                   value="@today"
                   min="@today"
                   max="@maxDate"
                   onchange="@onChangeScript"
                   required />
            @if (!string.IsNullOrEmpty(mapDescription))
            {
                <div class="form-text">@mapDescription</div>
            }
        </div>

        <div class="ratio ratio-16x9">
            <svg viewBox="@MapConfiguration.SvgViewBox"
                 xmlns="@MapConfiguration.SvgNamespace"
                 style="width:100%;height:100%;">

                <!-- Dynamicky generované sekce -->
                @foreach (var item in allRowData)
                {
                    var sekce = MapConfiguration.Sekce.FirstOrDefault(s => s.Id == item.Id);
                    if (sekce != null)
                    {
                        <a href="#@sekce.AnchorId" class="section-link" data-sekce-db="@sekce.Id">
                            <rect x="@item.X" y="@item.Y" width="@item.Width" height="@item.Height"
                                  class="section" data-id="@sekce.Id" />
                        </a>
                    }
                }

                <!-- Labely sekcí -->
                @foreach (var item in allRowData)
                {
                    var sekce = MapConfiguration.Sekce.FirstOrDefault(s => s.Id == item.Id);
                    if (sekce != null)
                    {
                        var labelX = item.X + (item.Width / 2);
                        var labelY = item.Y + (item.Height / 2) - 10;

                        // Rozhodni, zda je potøeba více øádkù
                        var shouldWrap = ShouldWrapText(sekce.Nazev, item.Width);
                        var lines = shouldWrap ? SplitTextOptimally(sekce.Nazev, item.Width) : new[] { sekce.Nazev };

                        <g>
                            <text x="@labelX" y="@labelY" text-anchor="middle" class="label" dominant-baseline="middle">
                                @for (int i = 0; i < lines.Length; i++)
                                {
                                    var dyOffset = i == 0 ? "0" : "1.2em";
                                    var cssClass = shouldWrap ? "label-line" : "label";
                                    <tspan x="@labelX" dy="@dyOffset" class="@cssClass">@lines[i]</tspan>
                                }
                            </text>
                        </g>
                    }
                }
            </svg>
        </div>
    </div>
</div>

@functions
{
    // Výpoèet pozic a šíøek sekcí pro øádek
    private List<(int Id, int X, int Y, int Width, int Height)> CalculateRowPositions(
        (int id, int seats)[] sections, int totalWidth, int startX, int y, int height)
    {
        var result = new List<(int Id, int X, int Y, int Width, int Height)>();
        var totalSeats = sections.Sum(s => s.seats);

        // Vymezená šíøka pro sekce (bez okrajù a paddingu)
        const int marginLeft = 20;
        const int marginRight = 20;
        const int sectionPadding = 3;  // Malá mezera mezi sekcemi

        var totalPadding = (sections.Length - 1) * sectionPadding;
        var availableWidth = totalWidth - marginLeft - marginRight - totalPadding;

        var currentX = startX + marginLeft;

        foreach (var (id, seats) in sections)
        {
            // Šíøka sekce pomìrovì k poètu míst
            var sectionWidth = (int)Math.Round(availableWidth * (double)seats / totalSeats);

            result.Add((Id: id, X: currentX, Y: y, Width: sectionWidth, Height: height));
            currentX += sectionWidth + sectionPadding;  // Pøidej padding pro pøíští sekci
        }

        return result;
    }

    // Rozhodni, zda má text potøebu více øádkù
    private bool ShouldWrapText(string text, int sectionWidth)
    {
        const double charsPerPixelSingleLine = 0.05;
        var estimatedWidth = text.Length / charsPerPixelSingleLine;
        return estimatedWidth > (sectionWidth - 20);
    }

    // Optimální rozdìlení textu na øádky
    private string[] SplitTextOptimally(string text, int sectionWidth)
    {
        var words = text.Split(' ');

        if (words.Length == 1)
            return new[] { text };

        var lines = new List<string>();
        var currentLine = "";

        foreach (var word in words)
        {
            var testLine = string.IsNullOrEmpty(currentLine) ? word : currentLine + " " + word;

            const double charsPerPixelSingleLine = 0.05;
            var estimatedWidth = testLine.Length / charsPerPixelSingleLine;

            if (estimatedWidth <= (sectionWidth - 20))
            {
                currentLine = testLine;
            }
            else
            {
                if (!string.IsNullOrEmpty(currentLine))
                    lines.Add(currentLine);
                currentLine = word;
            }
        }

        if (!string.IsNullOrEmpty(currentLine))
            lines.Add(currentLine);

        return lines.Count > 0 ? lines.ToArray() : new[] { text };
    }
}
