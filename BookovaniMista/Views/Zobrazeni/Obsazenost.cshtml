@using Business.BookovaniMista.Interfaces
@using Business.BookovaniMista
@using Business.BookovaniMista.Resources
@inject IMapaBusiness Mapa
@inject ICommonBusiness CommonBusinessService
@{
    ViewData[Constants.ViewDataKeys.Title] = "Obsazenost místnosti";

    var dateString = Context.Request.Query[Constants.RequestParameters.BookingDate].FirstOrDefault();
    DateTime bookingDate = CommonBusiness.ParseBookingDate(dateString);

    var sections = CommonBusinessService.GetSectionDefinitions();
    var sekceDbIds = sections.Select(s => s.Db).ToArray();
    var allReservations = await Mapa.GetAllReservationsForDateAsync(bookingDate, sekceDbIds);
}

<!-- ✅ Section Map PartialView (Reuse) -->
@await Html.PartialAsync(Constants.PartialViewNames.SectionMap, new
{ 
    Date = bookingDate, 
    Sections = sections,
    IntroText = "Zobrazte si obsazenost místnosti pro zvolený den.",
    MapTitle = "Vyberte den",
    MapDescription = "Zobrazte obsazenost pro konkrétní den.",
    ReadOnly = true,
    OnChangeScript = "document.location = '?" + Constants.RequestParameters.BookingDate + "=' + this.value"
})

<!-- ✅ Seat Grid PartialViews -->
@foreach (var s in sections)
{
    var bookedSeats = allReservations.ContainsKey(s.Db) ? allReservations[s.Db] : new Dictionary<int, string?>();

    @await Html.PartialAsync(Constants.PartialViewNames.SeatGrid, new
    {
        SekceDbId = s.Db,
        AnchorId = s.Id,
        Title = s.Title,
        Subtitle = s.Subtitle,
        Total = s.Total,
        Rows = s.Rows,
        BookedIndices = bookedSeats,
        CurrentUsername = (string?)null,
        ShowOwnerName = true
    })
}
